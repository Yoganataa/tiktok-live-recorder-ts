# ===================================================================
# TikTok Live Recorder - Environment Configuration
# ===================================================================

# ===================================================================
# TIKTOK AUTHENTICATION
# ===================================================================
# Get your session ID from browser cookies when logged into TikTok
# Required for: Followers mode, age-restricted content, private accounts
TIKTOK_SESSION_ID=

# Target IDC (Data Center)
# Default: useast2a
# Other options: useast1a, maliva
TIKTOK_TARGET_IDC=useast2a

# ===================================================================
# RECORDING CONFIGURATION
# ===================================================================
# Default output directory for recordings
# Leave empty for current directory
TIKTOK_OUTPUT_DIR=./recordings/

# ===================================================================
# PROXY CONFIGURATION (Optional)
# ===================================================================
# HTTP Proxy to bypass geo-restrictions
# Format: http://username:password@host:port or http://host:port
# Example: http://127.0.0.1:8080
TIKTOK_PROXY=

# ===================================================================
# VIDEO OUTPUT CONFIGURATION
# ===================================================================
# Output video format
# Supported: mp4, mkv, avi, mov, webm
# Default: mp4
VIDEO_OUTPUT_FORMAT=mp4

# Re-encoding option
# true  = Re-encode video (slower, more compatible, allows custom codecs)
# false = Stream copy (faster, preserves original quality)
# Default: false
VIDEO_REENCODE=false

# Keep original FLV file after conversion
# true  = Preserve original .flv file (uses 2x storage)
# false = Delete .flv after successful conversion
# Default: false
# Useful for: Archiving, quality comparison, re-encoding with different settings
KEEP_RAW_FILE=false

# ===================================================================
# CUSTOM CODEC CONFIGURATION (Optional)
# ===================================================================
# Only used when VIDEO_REENCODE=true
# Leave empty to use format defaults

# Video Codec
# Examples: libx264, libx265, libvpx-vp9, mpeg4, h264_nvenc (GPU)
VIDEO_CODEC=

# Audio Codec  
# Examples: aac, libopus, libmp3lame, libvorbis, copy
AUDIO_CODEC=

# ===================================================================
# TELEGRAM INTEGRATION (Optional)
# ===================================================================
# Enable automatic upload to Telegram after recording
# Get credentials from: https://my.telegram.org/apps

# Telegram API ID
TELEGRAM_API_ID=

# Telegram API Hash
TELEGRAM_API_HASH=

# Telegram Bot Token
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID
# Can be user ID or channel ID (use @userinfobot to get your ID)
# Example: 1234567890 or -1001234567890 (for channels)
TELEGRAM_CHAT_ID=

# ===================================================================
# ADVANCED SETTINGS (Optional)
# ===================================================================
# Recording mode
# Options: manual, automatic, followers
# Default: manual (configured via CLI)
# RECORDING_MODE=manual

# Automatic mode check interval (minutes)
# How often to check if user is live in automatic mode
# Default: 5
# AUTOMATIC_INTERVAL=5

# Maximum recording duration (seconds)
# Leave empty for unlimited recording
# Example: 3600 (1 hour)
# MAX_DURATION=

# ===================================================================
# CONFIGURATION EXAMPLES
# ===================================================================

# Example 1: Basic Recording (Fast, MP4 output)
# TIKTOK_SESSION_ID=your_session_here
# VIDEO_OUTPUT_FORMAT=mp4
# KEEP_RAW_FILE=false

# Example 2: Archiving Setup (Keep original FLV)
# TIKTOK_SESSION_ID=your_session_here  
# VIDEO_OUTPUT_FORMAT=mkv
# KEEP_RAW_FILE=true
# TIKTOK_OUTPUT_DIR=./archive/

# Example 3: Web Optimized (WebM with Telegram upload)
# TIKTOK_SESSION_ID=your_session_here
# VIDEO_OUTPUT_FORMAT=webm
# VIDEO_REENCODE=true
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# Example 4: Professional Setup (High quality, custom codecs)
# TIKTOK_SESSION_ID=your_session_here
# VIDEO_OUTPUT_FORMAT=mp4
# VIDEO_REENCODE=true
# VIDEO_CODEC=libx264
# AUDIO_CODEC=aac
# KEEP_RAW_FILE=true
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id